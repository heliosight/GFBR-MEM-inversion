                 RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ")"}]}]}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"tauHalf", ",", "tauPeak"}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"single", " ", "MEM", " ", "dataset"}], "*)"}], 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "mem", "]"}], "==", "4"}], "&&", 
        RowBox[{"VectorQ", "[", 
         RowBox[{"mem", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "&&", 
        RowBox[{"VectorQ", "[", 
         RowBox[{"mem", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ",", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tauHalf", ",", "tauPeak", ",", "cv"}], "}"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"tauHalf", ",", "tauPeak"}], "}"}], "=", 
           RowBox[{"compute", "[", "mem", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"cv", "=", 
           RowBox[{
            RowBox[{"Abs", "[", 
