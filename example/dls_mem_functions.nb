            RowBox[{"data", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"tau", "=", 
          RowBox[{"1", "/", "glist"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"d", "=", 
          RowBox[{"SortBy", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"tau", ",", "a"}], "}"}], "]"}], ",", "First"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", "peak", "*)"}], 
         RowBox[{"peakIdx", "=", 
          RowBox[{"First", "@", 
           RowBox[{"Ordering", "[", 
            RowBox[{
             RowBox[{"d", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"-", "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"tauPeak", "=", 
          RowBox[{"d", "[", 
           RowBox[{"[", 
            RowBox[{"peakIdx", ",", "1"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"aPeak", "=", 
          RowBox[{"d", "[", 
           RowBox[{"[", 
            RowBox[{"peakIdx", ",", "2"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"keep", " ", "left", " ", "side"}], "*)"}], 
         RowBox[{"left", "=", 
          RowBox[{"d", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", "peakIdx"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"remove", " ", "entropy", " ", "tail"}], "*)"}], 
         RowBox[{"thr", "=", 
          RowBox[{"thrFrac", " ", "aPeak"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"left", "=", 
          RowBox[{"Select", "[", 
           RowBox[{"left", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ">", "thr"}], "&"}]}], "]"}]}],
          ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"find", " ", "pair", " ", "bracketing", " ", "level"}], 
          "*)"}], 
         RowBox[{"pairs", "=", 
          RowBox[{"Partition", "[", 
           RowBox[{
            RowBox[{"left", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "2", ",", "1"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"i", "=", 
          RowBox[{"First", "@", 
           RowBox[{"FirstPosition", "[", 
            RowBox[{"pairs", ",", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"y1_", ",", "y2_"}], "}"}], "/;", 
              RowBox[{"y1", "<=", 
               RowBox[{"level", " ", "aPeak"}], "<=", "y2"}]}]}], "]"}]}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"(*", 
