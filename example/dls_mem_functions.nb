    RowBox[{
     RowBox[{
      RowBox[{"compute", "[", "data_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "glist", ",", "a", ",", "tau", ",", "d", ",", "peakIdx", ",", 
          "tauPeak", ",", "aPeak", ",", "left", ",", "thr", ",", "pairs", ",",
           "i", ",", "tauHalf"}], "}"}], ",", 
        RowBox[{
         RowBox[{"glist", "=", 
