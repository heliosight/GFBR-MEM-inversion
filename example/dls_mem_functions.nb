  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "compute", "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{
     "compute", " ", "peak", " ", "and", " ", "left", " ", "width", " ", 
