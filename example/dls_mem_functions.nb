             RowBox[{"1.177", " ", "tauPeak"}], ")"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"tauHalf", ",", "tauPeak", ",", "cv"}], "}"}]}]}], "]"}], ",", 
       RowBox[{"(*", 
        RowBox[{"list", " ", "of", " ", "MEM", " ", "datasets"}], "*)"}], 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"results", ",", "cv"}], "}"}], ",", 
         RowBox[{
          RowBox[{"results", "=", 
           RowBox[{"compute", "/@", "mem"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "CV", " ", "relative", " ", "to", " ", "each", " ", "peak"}], 
           "*)"}], 
          RowBox[{"cv", "=", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"results", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "2"}], "]"}], "]"}], "-", 
              RowBox[{"results", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"1.177", " ", 
              RowBox[{"results", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ")"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"results", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"results", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "cv"}], "}"}]}]}],
         "]"}]}], "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9823241064840717`*^9, 3.9823241064857903`*^9}},
 CellLabel->
  "(MEM) In[11]:=",ExpressionUUID->"0e0ceabb-0b91-4194-be59-bf41055ca58a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Handling the data", "Subsubsection",
 CellChangeTimes->{{3.97495978582804*^9, 
  3.974959796215364*^9}},ExpressionUUID->"1769f99b-08d3-4f4d-bcf1-\
a171ae403158"],

Cell[TextData[{
 "The MEM script grid in on the log scale, so returned values are attached to \
the point in gamma space. They are intensity weighted. In order to transform \
to density weight, the intensity at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "(", 
    SubscriptBox["\[Gamma]", "i"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d4445e4b-bc4d-4ddf-9614-f10d0c3bd0b0"],
 " should be divided by the length of the interval, i.e. ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b3b5d10e-969a-4941-bc6e-588c2c6355eb"],
 "-",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    RowBox[{"i", "+", "1"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "65a0df5a-4744-4e3e-972d-c0af7de2c1c3"],
 ", then the probability function will be recovered. Since it is a log \
spaced, the density for the longer times will be smaller. The following \
function converts intensity returned form dlsMEMc or dlsMEMu to probability. \
In the function code, the x is time, i.e. ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["gammaList", 
    RowBox[{"-", "1"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "12859809-6e32-46f8-989b-8391a8c8dbcf"],
 " and a is aRecovered."
}], "Text",
 CellChangeTimes->{{3.982060347614716*^9, 
  3.982060640297756*^9}},ExpressionUUID->"d5d0cdad-6ffa-4240-bfdf-\
743f2210437b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "pdfLinear", "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pdfLinear", "[", "data_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "a", ",", "n", ",", "dx"}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "a"}], "}"}], "=", 
      RowBox[{"Transpose", "[", "data", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "x", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dx", "=", 
      RowBox[{"Abs", "@", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"x", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "-", 
           RowBox[{"x", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"x", "[", 
             RowBox[{"[", 
              RowBox[{"3", ";;"}], "]"}], "]"}], "-", 
            RowBox[{"x", "[", 
             RowBox[{"[", 
              RowBox[{"1", ";;", 
               RowBox[{"-", "3"}]}], "]"}], "]"}]}], ")"}], "/", "2"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"x", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], "-", 
           RowBox[{"x", "[", 
            RowBox[{"[", 
             RowBox[{"-", "2"}], "]"}], "]"}]}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"a", "/", "dx"}]}], "}"}], "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.982062548018269*^9, 3.9820625589728537`*^9}},
 CellLabel->
  "(MEM) In[13]:=",ExpressionUUID->"2ad5b1cd-a8e6-4bc4-9c4e-257b1e6a6697"],

Cell["\<\
The function to determine the knee position on the L-curve of logCV vs LogC. \
Returns the index of the knee point, and corresponding constant C, and CV \
value.\
\>", "Text",
 CellChangeTimes->{{3.982407051635016*^9, 
  3.9824071331838284`*^9}},ExpressionUUID->"d8fe729f-40ff-4d23-a7d4-\
5f6ae3e2b319"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "kneeLCurve", "]"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kneeLCurve", "[", 
   RowBox[{"Cgrid_", ",", "CV_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "p1", ",", "p2", ",", "d", ",", "pos"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"log", "\[Dash]", 
      RowBox[{"log", " ", "coordinates"}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"x", "=", 
      RowBox[{"Log", "[", "Cgrid", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"y", "=", 
      RowBox[{"Log", "[", "CV", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", "endpoints", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"p1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"y", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"p2", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], ",", 
        RowBox[{"y", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"perpendicular", " ", "distances", " ", "to", " ", "line"}], 
      "*)"}], 
     RowBox[{"d", "=", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"p2", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "-", 
            RowBox[{"p1", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ")"}], " ", "x"}], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"p2", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "-", 
            RowBox[{"p1", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ")"}], " ", "y"}], "+", 
         RowBox[{
          RowBox[{"p2", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", 
          RowBox[{"p1", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"p2", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", 
          RowBox[{"p1", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"p2", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "-", 
            RowBox[{"p1", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "^", "2"}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"p2", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "-", 
            RowBox[{"p1", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", "2"}]}], "]"}]}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"knee", " ", "position"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"pos", "=", 
      RowBox[{
       RowBox[{"Ordering", "[", 
        RowBox[{"d", ",", 
         RowBox[{"-", "1"}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"pos", ",", 
       RowBox[{"Cgrid", "[", 
        RowBox[{"[", "pos", "]"}], "]"}], ",", 
       RowBox[{"CV", "[", 
        RowBox[{"[", "pos", "]"}], "]"}]}], "}"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.982303780702042*^9, 3.98230378070433*^9}, {
  3.982307494200348*^9, 3.982307504565607*^9}, {3.982390583732009*^9, 
  3.9823906038766937`*^9}},
 CellLabel->
  "(MEM) In[15]:=",ExpressionUUID->"c6392be7-3b8c-4bf7-bc27-66c59f16ea28"],

Cell["\<\
The function to compute the C-sweep diagnostics from an *.h5 file\
\>", "Text",
 CellChangeTimes->{{3.9824090731496563`*^9, 3.982409106188943*^9}, {
  3.98247901824587*^9, 
  3.9824790271658897`*^9}},ExpressionUUID->"a1dc1318-8551-466a-b7dc-\
45a084cb6d61"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "memScanAnalysis", "]"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"memScanAnalysis", "[", "file_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "gamma", ",", "aRec", ",", "res", ",", "ent", ",", "memout", ",", "cs", ",",
       "dia", ",", "kne"}], "}"}], ",", 
    RowBox[{
     RowBox[{"gamma", "=", 
      RowBox[{"Import", "[", 
       RowBox[{"file", ",", "\"\<gammaList\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"aRec", "=", 
      RowBox[{"Import", "[", 
       RowBox[{"file", ",", "\"\<aRecovered\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"res", "=", 
      RowBox[{"Import", "[", 
       RowBox[{"file", ",", "\"\<residualVec\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ent", "=", 
      RowBox[{"Import", "[", 
       RowBox[{"file", ",", "\"\<entropyVec\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"memout", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"gamma", ",", 
          RowBox[{"aRec", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{"res", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{"ent", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "aRec", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cs", "=", 
      RowBox[{"Import", "[", 
       RowBox[{"file", ",", "\"\<C_constants\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dia", "=", 
      RowBox[{"memPeakHalfInterp", "[", "memout", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"kne", "=", 
      RowBox[{"kneeLCurve", "[", 
       RowBox[{"cs", ",", 
        RowBox[{"dia", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"cs", ",", "dia", ",", "kne"}], "}"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.98240843193147*^9, 3.982408431933419*^9}},
 CellLabel->
  "In[1763]:=",ExpressionUUID->"fa2c51c8-9f38-4092-bfd1-b66e2b2c39c0"],

Cell["\<\
The hdf5 files for data storage and reuse. Consists of ISO8601 time stamp and \
export function. Takes the \[Lambda] value and the output of dlsMEMlog in \
{gammaList, gRecovered, residualVal, entropyVal} format.\
\>", "Text",
 CellChangeTimes->{{3.9749597991402197`*^9, 3.974959822611603*^9}, {
  3.9749602863617*^9, 3.974960302379978*^9}, {3.974960434534635*^9, 
  3.9749605231998653`*^9}},ExpressionUUID->"6062655f-f673-4788-b748-\
534f404f3f89"],

Cell[BoxData[
 RowBox[{
  RowBox[{"timeStamp", "[", "]"}], ":=", 
  RowBox[{"DateString", "[", 
   RowBox[{
    RowBox[{"{", "\"\<ISODateTime\>\"", "}"}], ",", 
    RowBox[{"TimeZone", "->", "0"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.974978109937943*^9, 3.974978122078471*^9}},
 CellLabel->
  "(MEM) In[19]:=",ExpressionUUID->"7e316fad-671d-4eeb-b456-be65a059bcad"],

Cell["Producing hdf5 file association containing data and metadata", "Text",
 CellChangeTimes->{{3.974978145539008*^9, 
  3.974978185418511*^9}},ExpressionUUID->"fb27863b-7424-47e7-88e5-\
db74e4303b99"],

Cell[BoxData[
 RowBox[{
  RowBox[{"makeH5Data", "[", 
   RowBox[{"\[Lambda]_", ",", "memOut_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"gamma", ",", "f", ",", "residual", ",", "entropy"}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"gamma", ",", "f", ",", "residual", ",", "entropy"}], "}"}], "=",
       "memOut"}], ";", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<data\>\"", "->", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<lambda\>\"", "->", "\[Lambda]"}], ",", 
          RowBox[{"\"\<gammaList\>\"", "->", "gamma"}], ",", 
          RowBox[{"\"\<gRecovered\>\"", "->", "f"}], ",", 
          RowBox[{"\"\<residualVal\>\"", "->", "residual"}], ",", 
          RowBox[{"\"\<entropyVal\>\"", "->", "entropy"}]}], "|>"}]}], ",", 
       RowBox[{"\"\<meta\>\"", "->", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<timestamp\>\"", "->", 
           RowBox[{"timeStamp", "[", "]"}]}], ",", 
          RowBox[{"\"\<log10lambda\>\"", "->", 
           RowBox[{"Log10", "[", "\[Lambda]", "]"}]}], ",", 
          RowBox[{"\"\<solver\>\"", "->", "\"\<Wolfram 14.3 NMinimize\>\""}], 
          ",", 
          
          RowBox[{"\"\<method\>\"", 
           "->", "\"\<Differential Evolution\>\""}]}], "|>"}]}]}], "|>"}]}]}],
    "]"}]}]], "Input",
 CellChangeTimes->{{3.974960118438177*^9, 3.974960137989357*^9}, {
  3.9749781058932943`*^9, 3.9749781067959003`*^9}, {3.977581260119108*^9, 
  3.9775813797430162`*^9}, {3.977586573293613*^9, 3.9775865779904127`*^9}, {
  3.977586633020852*^9, 3.977586665602694*^9}, {3.977586864565126*^9, 
  3.9775868648677464`*^9}, {3.977587154087981*^9, 3.977587199915736*^9}, {
  3.977587410103196*^9, 3.977587412518457*^9}, {3.9775875266913977`*^9, 
  3.9775875452471867`*^9}},
 CellLabel->
  "(MEM) In[20]:=",ExpressionUUID->"7d2fa771-0576-4bef-9263-8a900c2af744"],

Cell["\<\
Function to convert from machine real number of \[Lambda] to text string used \
in h5 name generation\
\>", "Text",
 CellChangeTimes->{{3.974963897568046*^9, 
  3.974963936512219*^9}},ExpressionUUID->"a9d73045-9263-481c-a9c0-\
