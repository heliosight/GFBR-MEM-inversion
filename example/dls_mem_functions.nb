Cell[CellGroupData[{

Cell["Diagnostics", "Subsubsection",
 CellChangeTimes->{{3.982069949908904*^9, 
  3.9820699564908037`*^9}},ExpressionUUID->"fb355727-e62a-48d0-b644-\
18e9da8b6cff"],

Cell[TextData[{
 "The function that computes the  ",
 StyleBox["memPeakHalfInterp",
  FontWeight->"Bold"],
 " extracts the dominant peak position and the left half-width from a MEM \
spectrum {gammaList, aRecovered, residualVec, entropyVec}. The distribution \
is converted to time domain (tau = 1/gamma), interpolated, \nand the left \
half-maximum is solved numerically. \nIf a single dataset is supplied, the \
function returns {tauHalf, tauPeak, CV}. \nIf a list of datasets is supplied, \
the peak of the first dataset is used as a reference and CV values are \
computed relative to that peak for all datasets."
}], "Text",
 CellChangeTimes->{{3.9820699623802443`*^9, 3.982069975807001*^9}, {
  3.9820700918003187`*^9, 
  3.9820701244117813`*^9}},ExpressionUUID->"a39bcaae-b7c0-4f4a-bfd2-\
fca1f657c547"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "memPeakHalfInterp", "]"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"memPeakHalfInterp", "[", 
   RowBox[{"mem_", ",", 
    RowBox[{"level_", ":", "0.5"}], ",", 
    RowBox[{"thrFrac_", ":", "0.01"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"compute", ",", "tauPeakRef"}], "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{
     "compute", " ", "peak", " ", "and", " ", "left", " ", "width", " ", 
      "for", " ", "one", " ", "MEM", " ", "dataset"}], "*)"}], 
    RowBox[{
     RowBox[{
      RowBox[{"compute", "[", "data_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "glist", ",", "a", ",", "tau", ",", "d", ",", "peakIdx", ",", 
          "tauPeak", ",", "aPeak", ",", "left", ",", "thr", ",", "pairs", ",",
           "i", ",", "tauHalf"}], "}"}], ",", 
        RowBox[{
         RowBox[{"glist", "=", 
          RowBox[{"data", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"a", "=", 
          RowBox[{"Clip", "[", 
           RowBox[{
            RowBox[{"data", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"tau", "=", 
          RowBox[{"1", "/", "glist"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"d", "=", 
          RowBox[{"SortBy", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"tau", ",", "a"}], "}"}], "]"}], ",", "First"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"peak", " ", "position"}], "*)"}], 
         RowBox[{"peakIdx", "=", 
          RowBox[{"First", "@", 
           RowBox[{"Ordering", "[", 
            RowBox[{
             RowBox[{"d", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"-", "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"tauPeak", "=", 
          RowBox[{"d", "[", 
           RowBox[{"[", 
            RowBox[{"peakIdx", ",", "1"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"aPeak", "=", 
          RowBox[{"d", "[", 
           RowBox[{"[", 
            RowBox[{"peakIdx", ",", "2"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"keep", " ", "left", " ", "side", " ", "of", " ", "peak"}], 
          "*)"}], 
         RowBox[{"left", "=", 
          RowBox[{"d", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", "peakIdx"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"remove", " ", "entropy", " ", "tail"}], "*)"}], 
         RowBox[{"thr", "=", 
          RowBox[{"thrFrac", " ", "aPeak"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"left", "=", 
          RowBox[{"Select", "[", 
           RowBox[{"left", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ">", "thr"}], "&"}]}], "]"}]}],
          ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "find", " ", "pair", " ", "bracketing", " ", "the", " ", "chosen", " ",
            "level"}], "*)"}], 
         RowBox[{"pairs", "=", 
          RowBox[{"Partition", "[", 
           RowBox[{
            RowBox[{"left", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "2", ",", "1"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"i", "=", 
          RowBox[{"First", "@", 
           RowBox[{"FirstPosition", "[", 
            RowBox[{"pairs", ",", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"y1_", ",", "y2_"}], "}"}], "/;", 
              RowBox[{"y1", "<=", 
               RowBox[{"level", " ", "aPeak"}], "<=", "y2"}]}]}], "]"}]}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "linear", " ", "interpolation", " ", "for", " ", "half", " ", 
           "width"}], "*)"}], 
         RowBox[{"tauHalf", "=", 
          RowBox[{
           RowBox[{"left", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "1"}], "]"}], "]"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"level", " ", "aPeak"}], "-", 
              RowBox[{"left", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ")"}], "*", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"left", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"i", "+", "1"}], ",", "1"}], "]"}], "]"}], "-", 
               RowBox[{"left", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"left", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"i", "+", "1"}], ",", "2"}], "]"}], "]"}], "-", 
               RowBox[{"left", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ")"}]}]}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"tauHalf", ",", "tauPeak"}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", "single"}]}]}]}]}], " ", "MEM", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"dataset", "--"}], "--"}], "--"}], "--"}], "--"}]}], 
      "*)"}], 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "mem", "]"}], "==", "4"}], "&&", 
        RowBox[{"VectorQ", "[", 
         RowBox[{"mem", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "&&", 
        RowBox[{"VectorQ", "[", 
         RowBox[{"mem", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ",", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tauHalf", ",", "tauPeak", ",", "cv"}], "}"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"tauHalf", ",", "tauPeak"}], "}"}], "=", 
           RowBox[{"compute", "[", "mem", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"cv", "=", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"tauPeak", "-", "tauHalf"}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"1.177", " ", "tauPeak"}], ")"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"return", ":", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"halfwidth", " ", "position"}], ",", 
              RowBox[{"peak", " ", "position"}], ",", "CV"}], "}"}]}], "*)"}],
           "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"tauHalf", ",", "tauPeak", ",", "cv"}], "}"}]}]}], "]"}], ",",
        "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
            RowBox[{"--", 
             RowBox[{"--", "list"}]}]}]}]}], " ", "of", " ", "MEM", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"datasets", "--"}], "--"}], "--"}], "--"}], "--"}]}], 
        "*)"}], 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "results", ",", "tauHalfList", ",", "tauPeakList", ",", "cv"}], 
          "}"}], ",", 
         RowBox[{"(*", 
          RowBox[{
          "reference", " ", "peak", " ", "from", " ", "first", " ", 
           "dataset"}], "*)"}], 
         RowBox[{
          RowBox[{"tauPeakRef", "=", 
           RowBox[{
            RowBox[{"compute", "[", 
             RowBox[{"mem", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "compute", " ", "peak", " ", "and", " ", "halfwidth", " ", "for", " ",
             "all", " ", "datasets"}], "*)"}], 
          RowBox[{"results", "=", 
           RowBox[{"compute", "/@", "mem"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"tauHalfList", "=", 
           RowBox[{"results", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"tauPeakList", "=", 
           RowBox[{"results", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "CV", " ", "relative", " ", "to", " ", "reference", " ", "peak"}], 
           "*)"}], 
          RowBox[{"cv", "=", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"tauHalfList", "-", "tauPeakRef"}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"1.177", " ", "tauPeakRef"}], ")"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"return", ":", 
            RowBox[{"{", 
             RowBox[{"halfwidths", ",", "peaks", ",", 
              RowBox[{"CV", " ", "values"}]}], "}"}]}], "*)"}], 
          RowBox[{"{", 
           RowBox[{"tauHalfList", ",", "tauPeakList", ",", "cv"}], "}"}]}]}], 
        "]"}]}], "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.982408227011644*^9, 3.982408227013348*^9}, {
  3.9824082653164682`*^9, 3.9824082676308727`*^9}},
 CellLabel->
  "(MEM) In[9]:=",ExpressionUUID->"6d271c4c-4039-4ef7-8842-016327ce82b8"],

