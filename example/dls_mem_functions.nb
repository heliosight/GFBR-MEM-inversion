Cell[CellGroupData[{

Cell[TextData[{
 "Converting ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "2"], TraditionalForm]],ExpressionUUID->
  "8a3ddec3-36a7-4031-be1f-665d7e427b21"],
 "-1 to g",
 Cell[BoxData[
  FormBox[
   SubscriptBox["", "1"], TraditionalForm]],ExpressionUUID->
  "c72f072f-5f47-4971-8bf0-da4bb5ec5829"],
 "(\[Tau])"
}], "Subsubsection",
 CellChangeTimes->{{3.977395758113832*^9, 3.977395791074513*^9}, {
  3.977409024818118*^9, 
  3.977409026199751*^9}},ExpressionUUID->"1d1f3310-ab60-48af-aac4-\
64fe29f28552"],

Cell[TextData[{
 "The function takes ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    FractionBox[
     RowBox[{
      SubscriptBox["g", "2"], "-", "1"}], 
     RowBox[{"Max", "[", 
      RowBox[{
       SubscriptBox["g", "2"], "-", "1"}], "]"}]]], TraditionalForm]],
  ExpressionUUID->"3c29f44c-60cd-46ae-bf91-49c2eb4e9147"],
 " and fits with Exp(-a t), then all the points below the threshold2 are \
clipped to 0, and between threshold1 and threshold2 are removed "
}], "Text",
 CellChangeTimes->{{3.978085215018362*^9, 3.978085227851315*^9}, {
  3.980255198431406*^9, 3.980255320648038*^9}, {3.9808425165863457`*^9, 
  3.980842593183401*^9}},ExpressionUUID->"1fe50c62-0f3a-4073-9335-\
d60b03aee548"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "clipG2toG1", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"clipG2toG1", "[", 
   RowBox[{"g2data_", ",", 
    RowBox[{"g1thCut_", ":", 
     RowBox[{"10", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "3"}]}]}]}], ",", 
    RowBox[{"g1thZero_", ":", 
     RowBox[{"1", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "4"}]}]}]}], ",", 
    RowBox[{"nkeep_", ":", "13"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "g1", ",", "fit", ",", "tCut", ",", "tZero", ",", "g1keep", ",", "tail", 
      ",", "g1zeros", ",", "norm"}], "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{"g1", " ", "from", " ", "g2", " ", 
      RowBox[{"(", 
       RowBox[{
       "same", " ", "normalization", " ", "as", " ", "your", " ", "original", 
        " ", "code"}], ")"}]}], "*)"}], 
    RowBox[{
     RowBox[{"norm", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"g2data", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"g1", "=", 
      RowBox[{"xySc", "[", 
       RowBox[{"g2data", ",", "Identity", ",", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"#", "/", "norm"}], "]"}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"single", " ", "exponential", " ", "fit"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"fit", "=", 
      RowBox[{"FindFit", "[", 
       RowBox[{"g1", ",", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "a"}], " ", "t"}], "]"}], ",", "a", ",", "t"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "two", " ", "cutoff", " ", "times", " ", "from", " ", "the", " ", 
       "fit"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tCut", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Log", "[", "g1thCut", "]"}]}], "/", "a"}], ")"}], "/.", 
       " ", "fit"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"keep", " ", "data", " ", "up", " ", "to", " ", "here"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tZero", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Log", "[", "g1thZero", "]"}]}], "/", "a"}], ")"}], "/.", 
       " ", "fit"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"start", " ", "zero"}], "-", 
       RowBox[{"padding", " ", "here"}]}], "*)"}], 
     RowBox[{"(*", 
      RowBox[{
      "keep", " ", "only", " ", "real", " ", "data", " ", "up", " ", "to", " ",
        "tCut"}], "*)"}], 
     RowBox[{"g1keep", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"g1", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "<=", "tCut"}], "&"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"take", " ", "first", " ", "nkeep", " ", "points", " ", 
        RowBox[{"at", "/", "after"}], " ", "tZero"}], ",", 
       RowBox[{"keep", " ", "their", " ", "original", " ", "times"}]}], 
      "*)"}], 
     RowBox[{"tail", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"g1", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ">=", "tZero"}], "&"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"g1zeros", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", "0"}], "}"}], "&"}], ")"}], "/@", 
       RowBox[{"Take", "[", 
        RowBox[{"tail", ",", 
         RowBox[{"UpTo", "[", "nkeep", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"return", ":", 
        RowBox[{
         RowBox[{"data", " ", "region"}], "+", 
         RowBox[{"explicit", " ", "zero"}], "-", "padding"}]}], ",", 
       RowBox[{"with", " ", "the", " ", "gap", " ", "deleted"}]}], "*)"}], 
     RowBox[{"Join", "[", 
      RowBox[{"g1keep", ",", "g1zeros"}], "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.978594818633339*^9, 3.978594818634966*^9}, 
   3.978595216973598*^9, 3.9785952524464273`*^9, {3.980842500481474*^9, 
   3.980842504676523*^9}},
 CellLabel->
  "(MEM) In[3]:=",ExpressionUUID->"60deaa87-847e-4eb4-97ef-4c7d049c8c16"]
}, Open  ]],

Cell[CellGroupData[{

Cell["MEM solvers", "Subsubsection",
 CellChangeTimes->{{3.9749876579378653`*^9, 
  3.974987662803822*^9}},ExpressionUUID->"fc084a98-fe25-4b98-8075-\
f69b8a343aaf"],

Cell[TextData[{
 StyleBox["Unconstrained MEM interior point IPOPT on simplex",
  FontWeight->"Bold"],
 "\nThe module for MEM deconvolution of exponential decay functions. It takes \
a list in format: {time, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["g", 
    RowBox[{"(", "2", ")"}]], TraditionalForm]],ExpressionUUID->
  "3af30c04-150f-4fcd-8e53-4388ca691921"],
 "-1}, step in \[Gamma]-space on log scale, and regularization parameter \
\[Lambda]. It returns generated \[Gamma]-list and recovered distribution of \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "i"], TraditionalForm]],ExpressionUUID->
  "b6db1c52-62f1-4ab6-97d7-e219ef89b0a8"],
 ", residuals ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox[
     OverscriptBox["g", "^"], "1"]}], TraditionalForm]],ExpressionUUID->
  "6764f594-ade6-4d88-b93b-e71a3e11a590"],
 " - ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{
     SubscriptBox["g", "1"], ")"}], "2"], TraditionalForm]],ExpressionUUID->
  "9d9992ed-187c-41af-bf04-99bd67a2fca5"],
 " of fit and entropy S = - ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "i"], 
    RowBox[{"log", "(", 
     SubscriptBox["a", "i"], ")"}], " "}], TraditionalForm]],ExpressionUUID->
  "b320ca5a-018e-4401-8af4-874d5d72b34b"],
 ". It uses NMinimize and IPOPT method."
}], "Text",
 CellChangeTimes->{{3.974887306074147*^9, 3.9748876636986628`*^9}, {
  3.974957540128957*^9, 3.974957550414624*^9}, {3.974987690437767*^9, 
  3.974987742573696*^9}, {3.975068512341794*^9, 3.975068534866797*^9}, {
  3.980836244443287*^9, 3.9808362575764513`*^9}, {3.980841914926512*^9, 
  3.9808421205520277`*^9}, {3.981112948852785*^9, 
  3.981113012698113*^9}},ExpressionUUID->"029711a1-17aa-40e7-928a-\
7162e19a1d27"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "dlsMEMu", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dlsMEMu", "[", 
   RowBox[{"dlsData_List", ",", 
    RowBox[{"step_", ":", "0.1"}], ",", 
    RowBox[{"\[Lambda]_", ":", 
     RowBox[{"5", " ", 
      SuperscriptBox["10", 
       RowBox[{"-", "5"}]]}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tauList", ",", "g1Noisy", ",", "gammaList", ",", "n", ",", "aVars", ",",
       "kernel", ",", "gammaTauMatrix", ",", 
      RowBox[{"gammaCutoff", "=", "50"}], ",", "solution", ",", "aRecovered", 
      ",", "modelG1Fit", ",", "residualVec", ",", "entropyVec", ",", 
      RowBox[{"eps", "=", 
       RowBox[{"10", "^", 
        RowBox[{"-", "12"}]}]}], ",", "a"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"1.", " ", "Extract", " ", "data"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tauList", "=", 
      RowBox[{"dlsData", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"g1Noisy", "=", 
      RowBox[{"dlsData", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"2.", " ", "Gamma", " ", "grid"}], "*)"}], 
     RowBox[{"gammaList", "=", 
      RowBox[{"Exp", "[", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"1", "/", 
           RowBox[{"Max", "[", "tauList", "]"}]}], "]"}], ",", 
         RowBox[{"Log", "[", 
          RowBox[{"1", "/", 
           RowBox[{"Min", "[", "tauList", "]"}]}], "]"}], ",", "step"}], 
        "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "gammaList", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"3.", " ", "Distribution", " ", "amplitudes", " ", "a_i"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"aVars", "=", 
      RowBox[{"Array", "[", 
       RowBox[{"a", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"4.", " ", "Kernel"}], "*)"}], 
     RowBox[{"gammaTauMatrix", "=", 
      RowBox[{"Clip", "[", 
       RowBox[{
        RowBox[{"Outer", "[", 
         RowBox[{"Times", ",", "tauList", ",", "gammaList"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "gammaCutoff"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"kernel", "=", 
      RowBox[{"Exp", "[", 
       RowBox[{"-", "gammaTauMatrix"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "5.", " ", "Objective", " ", "with", " ", "simplex", " ", 
       "constraint"}], "*)"}], 
     RowBox[{"solution", "=", 
      RowBox[{"NMinimize", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"modelG1", ",", "kappa", ",", "entropy"}], "}"}], ",", 
            RowBox[{
             RowBox[{"modelG1", "=", 
              RowBox[{"kernel", ".", "aVars"}]}], ";", "\[IndentingNewLine]", 
             
             RowBox[{"kappa", "=", 
              RowBox[{"Total", "[", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"modelG1", "-", "g1Noisy"}], ")"}], "^", "2"}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"entropy", "=", 
              RowBox[{"-", 
               RowBox[{"Total", "[", 
                RowBox[{"aVars", " ", 
                 RowBox[{"Log", "[", 
                  RowBox[{"aVars", "+", "eps"}], "]"}]}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"kappa", "-", 
              RowBox[{"\[Lambda]", " ", "entropy"}]}]}]}], "]"}], ",", 
          RowBox[{
           RowBox[{"Thread", "[", 
            RowBox[{"aVars", ">=", "eps"}], "]"}], "&&", 
           RowBox[{
            RowBox[{"Total", "[", "aVars", "]"}], "==", "1"}]}]}], "}"}], ",",
         "aVars", ",", 
        RowBox[{"Method", "->", "\"\<IPOPT\>\""}], ",", 
        RowBox[{"MaxIterations", "->", "300"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"6.", " ", "Recover", " ", "solution"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"aRecovered", "=", 
      RowBox[{"aVars", "/.", " ", 
       RowBox[{"solution", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"modelG1Fit", "=", 
      RowBox[{"kernel", ".", "aRecovered"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"residualVec", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"modelG1Fit", "-", "g1Noisy"}], ")"}], "^", "2"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"entropyVec", "=", 
      RowBox[{
       RowBox[{"-", "aRecovered"}], " ", 
       RowBox[{"Log", "[", 
        RowBox[{"aRecovered", "+", "eps"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
      "gammaList", ",", "aRecovered", ",", "residualVec", ",", "entropyVec"}],
       "}"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.981107763237371*^9, 3.9811078037855463`*^9}, 
   3.9811152772437677`*^9, {3.982132862513144*^9, 3.982132863834196*^9}, {
   3.9822405735063334`*^9, 3.982240577943719*^9}},
 CellLabel->
  "(MEM) In[5]:=",ExpressionUUID->"9af59365-bb25-4665-960c-1e3696ed8cbe"],

Cell[TextData[{
 StyleBox["Constrained MEM, Interior Point on simplex",
  FontWeight->"Bold"],
 "\nThe module for MEM deconvolution of exponential decay functions. It takes \
a list in format: {time, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["g", 
    RowBox[{"(", "2", ")"}]], TraditionalForm]],ExpressionUUID->
  "35a7260c-6a84-4f14-b62a-a42a978b0406"],
 "-1}, step in \[Gamma]-space on log scale, and an instrument constant C. It \
returns generated \[Gamma]-list and recovered distribution of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "i"], TraditionalForm]],ExpressionUUID->
  "fccc1de4-c404-4421-b98a-1065c3fd2c5f"],
 ", residuals ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox[
     OverscriptBox["g", "^"], "i"]}], TraditionalForm]],ExpressionUUID->
  "006d7ddc-51de-4df4-a81d-c52126fcf435"],
 " - ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{
     SubscriptBox["g", "i"], ")"}], "2"], TraditionalForm]],ExpressionUUID->
  "a10364e2-aed4-49d0-8f12-db6d915b154a"],
 " of fit and entropy S = - ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "i"], 
    RowBox[{"log", "(", 
     SubscriptBox["a", "i"], ")"}], " "}], TraditionalForm]],ExpressionUUID->
  "fa9e1450-05cb-433d-a8b4-fa1a7d1a0fd0"],
 ". It uses NMaximize and IPOPT method."
}], "Text",
 CellChangeTimes->{{3.980255539335883*^9, 3.980255563605164*^9}, {
   3.980842133607459*^9, 3.980842284102759*^9}, 3.980842360085947*^9, {
   3.98111302097068*^9, 
   3.981113022037616*^9}},ExpressionUUID->"97b9e3d6-6668-4b95-acd8-\
26848ec07c80"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "dlsMEMc", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"dlsMEMc", "[", 
   RowBox[{"dlsData_List", ",", 
    RowBox[{"step_", ":", "0.1"}], ",", 
    RowBox[{"const_", ":", 
     RowBox[{"6.", " ", 
      SuperscriptBox["10", 
       RowBox[{"-", "4"}]]}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tauList", ",", "g1Noisy", ",", "gammaList", ",", "n", ",", "aVars", ",",
       "kernel", ",", "gammaTauMatrix", ",", 
      RowBox[{"gammaCutoff", "=", "50"}], ",", "solution", ",", "aRecovered", 
      ",", "modelG1Fit", ",", "residualVec", ",", "entropyVec", ",", 
      RowBox[{"eps", "=", 
       RowBox[{"10", "^", 
        RowBox[{"-", "12"}]}]}], ",", "a"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"1.", " ", "Extract", " ", "data"}], "*)"}], 
    RowBox[{
     RowBox[{"tauList", "=", 
      RowBox[{"dlsData", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"g1Noisy", "=", 
      RowBox[{"dlsData", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"2.", " ", "Gamma", " ", "grid"}], "*)"}], 
     RowBox[{"gammaList", "=", 
      RowBox[{"Exp", "[", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"1", "/", 
           RowBox[{"Max", "[", "tauList", "]"}]}], "]"}], ",", 
         RowBox[{"Log", "[", 
          RowBox[{"1", "/", 
           RowBox[{"Min", "[", "tauList", "]"}]}], "]"}], ",", "step"}], 
        "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "gammaList", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"3.", " ", "Distribution", " ", "amplitudes", " ", "a_i"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"aVars", "=", 
      RowBox[{"Array", "[", 
       RowBox[{"a", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"4.", " ", "Kernel"}], "*)"}], 
     RowBox[{"gammaTauMatrix", "=", 
      RowBox[{"Clip", "[", 
       RowBox[{
        RowBox[{"Outer", "[", 
         RowBox[{"Times", ",", "tauList", ",", "gammaList"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "gammaCutoff"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"kernel", "=", 
      RowBox[{"Exp", "[", 
       RowBox[{"-", "gammaTauMatrix"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"5.", " ", "Constrained", " ", "MEM"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"solution", "=", 
      RowBox[{"NMaximize", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Total", "[", 
            RowBox[{"aVars", " ", 
             RowBox[{"Log", "[", 
              RowBox[{"(", 
               RowBox[{"aVars", "+", "eps"}], ")"}], "]"}]}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"Thread", "[", 
            RowBox[{"aVars", ">=", 
             RowBox[{"10", "^", 
              RowBox[{"-", "12"}]}]}], "]"}], "&&", 
           RowBox[{
            RowBox[{"Total", "[", "aVars", "]"}], "==", "1"}], "&&", 
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"kernel", ".", "aVars"}], "-", "g1Noisy"}], ")"}], "^",
               "2"}], "]"}], "<=", "const"}]}]}], "}"}], ",", "aVars", ",", 
        RowBox[{"Method", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<IPOPT\>\"", ",", 
           RowBox[{"\"\<Tolerance\>\"", "->", 
            SuperscriptBox["10", 
             RowBox[{"-", "5"}]]}], ",", 
           RowBox[{"\"\<MaxIterations\>\"", "->", "200"}]}], "}"}]}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"6.", " ", "Recover", " ", "solution"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"aRecovered", "=", 
      RowBox[{"aVars", "/.", " ", 
       RowBox[{"solution", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"modelG1Fit", "=", 
      RowBox[{"kernel", ".", "aRecovered"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"residualVec", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"modelG1Fit", "-", "g1Noisy"}], ")"}], "^", "2"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"entropyVec", "=", 
      RowBox[{
       RowBox[{"-", "aRecovered"}], " ", 
       RowBox[{"Log", "[", 
        RowBox[{"aRecovered", "+", "eps"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
      "gammaList", ",", "aRecovered", ",", "residualVec", ",", "entropyVec"}],
       "}"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9803255598849*^9, 3.9803255598879538`*^9}, {
   3.9808363538108377`*^9, 3.980836397914743*^9}, {3.9808366385223227`*^9, 
   3.980836649851386*^9}, 3.9808370049296713`*^9, {3.981026154831262*^9, 
