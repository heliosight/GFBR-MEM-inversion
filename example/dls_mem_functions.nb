Cell[CellGroupData[{

Cell["Time to hydrodynamic radius", "Subsubsection",
 CellChangeTimes->{{3.978006268372308*^9, 
  3.9780062784309387`*^9}},ExpressionUUID->"0e2d9228-ff64-4367-9311-\
7642566e5c8b"],

Cell["\<\
The function converting the radius to time in seconds using Stokes-Einstein \
and Malvern geometry at RT in water.\
\>", "Text",
 CellChangeTimes->{{3.978007255527948*^9, 3.978007300270034*^9}, 
   3.980842461493804*^9},ExpressionUUID->"3f40a30d-8fe9-4485-97be-\
850be6dda04a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RadiusNMToTau", "[", 
   RowBox[{"Rnm_", ",", 
    RowBox[{"lambda_", ":", 
     RowBox[{"633", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "9"}]}]}]}], ",", 
    RowBox[{"theta_", ":", 
     RowBox[{"173", " ", "Degree"}]}], ",", 
    RowBox[{"n_", ":", "1.33"}], ",", 
    RowBox[{"T_", ":", "298"}], ",", 
    RowBox[{"eta_", ":", "0.00089"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"kB", ",", "q", ",", "R"}], "}"}], ",", 
    RowBox[{
     RowBox[{"kB", "=", 
      RowBox[{"1.380649", "*", 
       RowBox[{"10", "^", 
        RowBox[{"-", "23"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"q", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", " ", "Pi", " ", 
         RowBox[{"n", "/", "lambda"}]}], ")"}], " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"theta", "/", "2"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"R", "=", 
      RowBox[{"Rnm", "*", 
       RowBox[{"10", "^", 
        RowBox[{"-", "9"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"6", " ", "Pi", " ", "eta", " ", "R"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"kB", " ", "T", " ", 
        RowBox[{"q", "^", "2"}]}], ")"}]}]}]}], "]"}]}]], "Input",
 CellLabel->
  "(MEM) In[21]:=",ExpressionUUID->"105c842c-fcec-4523-92aa-a15e612a8869"],

Cell["\<\
The inverse to above function that converts time, to radius using \
Stokes-Einstein formalism to radius in nm.\
\>", "Text",
 CellChangeTimes->{{3.978006326613323*^9, 3.978006363437653*^9}, {
  3.9780073040526114`*^9, 
  3.9780073072732487`*^9}},ExpressionUUID->"4f4c9c4e-9bfc-47cb-bf70-\
ac7be7aed711"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TauToRadiusNM", "[", 
   RowBox[{"tau_", ",", 
    RowBox[{"lambda_", ":", 
     RowBox[{"633", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "9"}]}]}]}], ",", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"laser", " ", "wavelength"}], ",", "m"}], "*)"}], 
    RowBox[{"theta_", ":", 
     RowBox[{"173", " ", "Degree"}]}], ",", 
    RowBox[{"(*", 
     RowBox[{"scattering", " ", "angle"}], "*)"}], 
    RowBox[{"n_", ":", "1.33"}], ",", 
    RowBox[{"(*", 
     RowBox[{"refractive", " ", "index", " ", "of", " ", "water"}], "*)"}], 
    RowBox[{"T_", ":", "298"}], ",", 
    RowBox[{"(*", 
     RowBox[{"temperature", ",", "K"}], "*)"}], 
    RowBox[{"eta_", ":", "0.00089"}]}], "           ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"viscosity", " ", "of", " ", "water"}], ",", 
     RowBox[{"Pa", " ", "s"}]}], "*)"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"kB", ",", "q", ",", "R"}], "}"}], ",", 
    RowBox[{
     RowBox[{"kB", "=", 
      RowBox[{"1.380649", "*", 
       RowBox[{"10", "^", 
        RowBox[{"-", "23"}]}]}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"Boltzmann", " ", "constant"}], "*)"}], 
     RowBox[{"q", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", " ", "Pi", " ", 
         RowBox[{"n", "/", "lambda"}]}], ")"}], " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"theta", "/", "2"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"R", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"kB", " ", "T", " ", 
         RowBox[{"q", "^", "2"}], " ", "tau"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"6", " ", "Pi", " ", "eta"}], ")"}]}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"radius", " ", "in", " ", "meters"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Round", "[", 
      RowBox[{
       RowBox[{"R", "*", 
        RowBox[{"10", "^", "9"}]}], ",", "0.1"}], "]"}]}]}], "     ", 
   RowBox[{"(*", 
    RowBox[{"convert", " ", "to", " ", "nm"}], "*)"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9780062805252666`*^9, 3.978006320334708*^9}, {
  3.978006443013253*^9, 3.978006448461751*^9}},
 CellLabel->
  "(MEM) In[22]:=",ExpressionUUID->"4d8176ca-f73e-4dee-bf14-621f3d3427bf"]
}, Open  ]]
},
