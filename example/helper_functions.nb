Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"original", " ", "version", "\[IndentingNewLine]", 
     RowBox[{"smooth", "[", 
      RowBox[{"data_", ",", "lambda_", ",", "order_"}], "]"}]}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"y", "=", "data"}], ",", 
        RowBox[{"\[Lambda]", "=", "lambda"}], ",", 
        RowBox[{"o", "=", "order"}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"Clear", "[", "f", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"m", "=", 
        RowBox[{"Length", "[", "y", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"e", "=", 
        RowBox[{"IdentityMatrix", "[", "m", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"d", "=", 
        RowBox[{"Differences", "[", 
         RowBox[{"e", ",", "o"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"f", "=", 
        RowBox[{"LinearSolve", "[", 
         RowBox[{"(", 
          RowBox[{"e", "+", 
           RowBox[{
            RowBox[{"N", "[", "\[Lambda]", "]"}], " ", 
            RowBox[{
             RowBox[{"d", "\[Transpose]"}], ".", "d"}]}]}], ")"}], "]"}]}], ";", 
       RowBox[{"Clear", "[", 
        RowBox[{"m", ",", "e", ",", "d"}], "]"}], ";", 
       RowBox[{"f", "[", 
        RowBox[{"N", "[", "y", "]"}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "*)"}]], "Input",
 CellChangeTimes->{{3.915866068549399*^9, 3.915866104769104*^9}, {
  3.916301748727461*^9, 3.916301767984567*^9}, {3.916301928270814*^9, 
  3.916301943235065*^9}, {3.919832656238858*^9, 3.919832660509721*^9}, {
  3.919833904568481*^9, 3.919833964716541*^9}, {3.977392424069726*^9, 
  3.977392438776091*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"5bd662b1-46c1-4f12-888a-c69c97c9db38"],

Cell[BoxData[
 RowBox[{
  RowBox[{"smooth", "[", 
   RowBox[{"data_", ",", 
    RowBox[{"lambda_", ":", 
     RowBox[{"0.5", "*", 
      RowBox[{"10", "^", "3"}]}]}], ",", 
    RowBox[{"order_", ":", "3"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Lambda]", "=", 
       RowBox[{"N", "@", "lambda"}]}], ",", 
      RowBox[{"o", "=", "order"}], ",", "m", ",", "e", ",", "d", ",", "f", ",",
       "y"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"1", "D", " ", 
      RowBox[{"case", ":", 
       RowBox[{"data", " ", "is", " ", "a", " ", "vector"}]}]}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"VectorQ", "[", 
        RowBox[{"data", ",", "NumericQ"}], "]"}], ",", 
       RowBox[{
        RowBox[{"y", "=", 
         RowBox[{"N", "@", "data"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"m", "=", 
         RowBox[{"Length", "@", "y"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"e", "=", 
         RowBox[{"IdentityMatrix", "[", "m", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"d", "=", 
         RowBox[{"Differences", "[", 
          RowBox[{"e", ",", "o"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"f", "=", 
         RowBox[{"LinearSolve", "[", 
          RowBox[{"e", "+", 
           RowBox[{"\[Lambda]", " ", 
            RowBox[{
             RowBox[{"Transpose", "[", "d", "]"}], ".", "d"}]}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"Return", "[", 
         RowBox[{"f", "[", "y", "]"}], "]"}], ";"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"2", "D", " ", 
        RowBox[{"case", ":", 
         RowBox[{"data", " ", "is", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", "y"}], "}"}], ",", "..."}], "}"}]}]}]}], "->", 
       
       RowBox[{
       "smooth", " ", "only", " ", "y", " ", "and", " ", "keep", " ", "x"}]}],
       "*)"}], 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"MatrixQ", "[", 
         RowBox[{"data", ",", "NumericQ"}], "]"}], "&&", 
        RowBox[{
         RowBox[{
          RowBox[{"Dimensions", "[", "data", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], "==", "2"}]}], ",", 
       RowBox[{
        RowBox[{"y", "=", 
         RowBox[{"N", "@", 
          RowBox[{"data", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"m", "=", 
         RowBox[{"Length", "@", "y"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"e", "=", 
         RowBox[{"IdentityMatrix", "[", "m", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"d", "=", 
         RowBox[{"Differences", "[", 
          RowBox[{"e", ",", "o"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"f", "=", 
         RowBox[{"LinearSolve", "[", 
          RowBox[{"e", "+", 
           RowBox[{"\[Lambda]", " ", 
            RowBox[{
             RowBox[{"Transpose", "[", "d", "]"}], ".", "d"}]}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"Return", "[", 
         RowBox[{"Transpose", "@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"data", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"f", "[", "y", "]"}]}], "}"}]}], "]"}], ";"}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", "otherwise", "*)"}], "\[IndentingNewLine]", "$Failed"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"3a7ce199-8441-4df4-98d1-398109c2eb56"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
   RowBox[{"original", " ", "version", "\[IndentingNewLine]", 
    RowBox[{"bckgrnd", "[", 
     RowBox[{"ydata_", ",", "weight_", ",", "lambda_", ",", "iterations_"}], 
     "]"}]}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"y", "=", "ydata"}], ",", 
       RowBox[{"p", "=", "weight"}], ",", 
       RowBox[{"\[Lambda]", "=", "lambda"}], ",", " ", 
       RowBox[{"it", "=", "iterations"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"m", "=", 
       RowBox[{"Length", "[", "y", "]"}]}], ";", 
      RowBox[{"Clear", "[", "z", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"dff", "=", 
       RowBox[{"Differences", "[", 
        RowBox[{
         RowBox[{"IdentityMatrix", "[", "m", "]"}], ",", "2"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"w", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"1", ",", "m"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"W", "=", 
          RowBox[{"DiagonalMatrix", "[", "w", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"cho", "=", 
          RowBox[{"CholeskyDecomposition", "[", 
           RowBox[{"W", "+", 
            RowBox[{
             RowBox[{"N", "[", "\[Lambda]", "]"}], 
             RowBox[{
              RowBox[{"dff", "\[Transpose]"}], ".", "dff"}]}]}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"z", "=", 
          RowBox[{"LinearSolve", "[", 
           RowBox[{"cho", ",", 
            RowBox[{"LinearSolve", "[", 
             RowBox[{
              RowBox[{"cho", "\[Transpose]"}], ",", 
              RowBox[{"w", " ", "y"}]}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"w", "=", 
          RowBox[{
           RowBox[{"Array", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"N", "@", "p"}], " ", 
               RowBox[{"Boole", "[", 
                RowBox[{
                 RowBox[{"y", "[", 
                  RowBox[{"[", "#", "]"}], "]"}], ">", 
                 RowBox[{"z", "[", 
                  RowBox[{"[", "#", "]"}], "]"}]}], "]"}]}], "&"}], ",", 
             RowBox[{"Length", "[", "y", "]"}]}], "]"}], "+", 
           RowBox[{"Array", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 RowBox[{"N", "@", "p"}]}], ")"}], 
               RowBox[{"Boole", "[", 
                RowBox[{
                 RowBox[{"y", "[", 
                  RowBox[{"[", "#", "]"}], "]"}], "<", 
                 RowBox[{"z", "[", 
                  RowBox[{"[", "#", "]"}], "]"}]}], "]"}]}], "&"}], ",", 
             RowBox[{"Length", "[", "y", "]"}]}], "]"}]}]}], ";"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "it"}], "}"}]}], "]"}], ";", 
      RowBox[{"Clear", "[", 
       RowBox[{
       "y", ",", "p", ",", "\[Lambda]", ",", "m", ",", "w", ",", "dff", ",", 
        "W", ",", "cho", ",", " ", "it"}], "]"}], ";", " ", "z"}]}], "]"}]}], 
  "\[IndentingNewLine]", "*)"}]], "Input",
 CellChangeTimes->{{3.915856564533486*^9, 3.915856756761422*^9}, {
  3.915856852629151*^9, 3.915856857119557*^9}, {3.9158572221941*^9, 
  3.915857224903541*^9}, {3.915857380795929*^9, 3.915857424318028*^9}, {
  3.915857502798089*^9, 3.9158575069794807`*^9}, {3.91586612483215*^9, 
  3.91586614810404*^9}, {3.91630177502697*^9, 3.91630180007797*^9}, {
  3.9163019748769007`*^9, 3.916301981122416*^9}, {3.97739239020947*^9, 
  3.9773924453068542`*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"758fb17e-0a7c-44a5-af6c-0e7f99bd5766"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bckgrnd", "[", 
   RowBox[{"data_", ",", 
    RowBox[{"weight_", ":", 
     RowBox[{"5", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "3"}]}]}]}], ",", 
    RowBox[{"lambda_", ":", 
     RowBox[{"10", "^", "5"}]}], ",", 
    RowBox[{"iterations_", ":", "10"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"p", "=", "weight"}], ",", 
      RowBox[{"\[Lambda]", "=", "lambda"}], ",", 
      RowBox[{"it", "=", "iterations"}], ",", "y", ",", "x", ",", "m", ",", 
      "z", ",", "dff", ",", "w", ",", "W", ",", "cho"}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"VectorQ", "[", "data", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"None", ",", "data"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"data", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
          RowBox[{"data", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"m", "=", 
      RowBox[{"Length", "[", "y", "]"}]}], ";", 
     RowBox[{"Clear", "[", "z", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"dff", "=", 
      RowBox[{"Differences", "[", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "m", "]"}], ",", "2"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"w", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"1", ",", "m"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"W", "=", 
         RowBox[{"DiagonalMatrix", "[", "w", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"cho", "=", 
         RowBox[{"CholeskyDecomposition", "[", 
          RowBox[{"W", "+", 
           RowBox[{
            RowBox[{"N", "[", "\[Lambda]", "]"}], " ", 
            RowBox[{
             RowBox[{"dff", "\[Transpose]"}], ".", "dff"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"z", "=", 
         RowBox[{"LinearSolve", "[", 
          RowBox[{"cho", ",", 
           RowBox[{"LinearSolve", "[", 
            RowBox[{
             RowBox[{"cho", "\[Transpose]"}], ",", 
             RowBox[{"w", " ", "y"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"w", "=", 
         RowBox[{
          RowBox[{"Array", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"N", "@", "p"}], " ", 
              RowBox[{"Boole", "[", 
               RowBox[{
                RowBox[{"y", "[", 
                 RowBox[{"[", "#", "]"}], "]"}], ">", 
                RowBox[{"z", "[", 
                 RowBox[{"[", "#", "]"}], "]"}]}], "]"}]}], "&"}], ",", "m"}],
            "]"}], "+", 
          RowBox[{"Array", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{"N", "@", "p"}]}], ")"}], " ", 
              RowBox[{"Boole", "[", 
               RowBox[{
                RowBox[{"y", "[", 
                 RowBox[{"[", "#", "]"}], "]"}], "<", 
                RowBox[{"z", "[", 
                 RowBox[{"[", "#", "]"}], "]"}]}], "]"}]}], "&"}], ",", "m"}],
            "]"}]}]}], ";"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "it"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"x", "===", "None"}], ",", "z", ",", 
       RowBox[{"Transpose", "@", 
        RowBox[{"{", 
         RowBox[{"x", ",", "z"}], "}"}]}]}], "]"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"412ca90b-fb7c-4bc0-ab90-da3d4e707479"]
