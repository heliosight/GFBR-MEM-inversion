Cell[CellGroupData[{

Cell["Protein charge vs pH", "Subsubsection",
 CellChangeTimes->{{3.9535524063332*^9, 
  3.9535524140288277`*^9}},ExpressionUUID->"01173283-d8ad-406c-9ab8-\
10cc33fa0a40"],

Cell["\<\
The function to calculate the charge vs pH from protein sequence. The aam \
function returns values of pKa from the database file aa_pKa.nb based on \
reference data from many proteins. The second one computes charge and \
absolute charge, i.e. negative and positive values vs positive values.\
\>", "Text",
 CellChangeTimes->{{3.9535524220750427`*^9, 
  3.953552553954134*^9}},ExpressionUUID->"daaebf31-390a-47fa-b668-\
d7e72362a03b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"aam", "[", 
   RowBox[{"data_", ",", "code_String"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "entry", "}"}], ",", 
    RowBox[{
     RowBox[{"entry", "=", 
      RowBox[{"SelectFirst", "[", 
       RowBox[{"data", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "===", "code"}], "&"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"entry", "=!=", 
        RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}], ",", 
       RowBox[{"First", "[", 
        RowBox[{"entry", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "]"}], ",", 
       RowBox[{"Missing", "[", "\"\<NoMatch\>\"", "]"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[33]:=",ExpressionUUID->"8a647041-18b2-4022-8021-9b40f8b0c717"],

Cell[BoxData[
 RowBox[{
  RowBox[{"chsq", "[", 
   RowBox[{"sequence_", ",", "data_", ",", "phshift_", ",", "ph_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"seq", "=", "sequence"}], ",", 
      RowBox[{"d", "=", "data"}], ",", 
      RowBox[{"dpH", "=", "phshift"}], ",", 
      RowBox[{"pH", "=", "ph"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{
      "aa", ",", "q0", ",", "aac", ",", "aan", ",", "aach", ",", "aps", ",", 
       "q", ",", "acid", ",", "base", ",", "f", ",", "charge", ",", "chden"}],
       "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"aa", "=", 
      RowBox[{"{", 
       RowBox[{"\"\<C\>\"", ",", "\"\<Y\>\"", ",", "\"\<D\>\"", 
        ",", "\"\<E\>\"", ",", "\"\<K\>\"", ",", "\"\<R\>\"", 
        ",", "\"\<H\>\""}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"q0", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", "1", ",", "1", ",", "1"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"aac", "=", 
      RowBox[{"Evaluate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"StringCases", "[", 
          RowBox[{"seq", ",", "#"}], "]"}], "&"}], "/@", "aa"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"aan", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "#", "]"}], "&"}], "/@", "aac"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"aach", "=", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Flatten", "@", "aac"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"aps", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"aa", ",", "#"}], "]"}], "&"}], "/@", "aach"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"q", "=", 
      RowBox[{"q0", "[", 
       RowBox[{"[", "aps", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"acid", "[", 
       RowBox[{"pKa_", ",", "pH_"}], "]"}], "=", 
      RowBox[{"N", "@", 
       FractionBox[
        SuperscriptBox["10", 
         RowBox[{"pH", "-", "pKa"}]], 
        RowBox[{
         SuperscriptBox["10", 
          RowBox[{"pH", "-", "pKa"}]], "+", "1"}]]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"base", "[", 
       RowBox[{"pKa_", ",", "pH_"}], "]"}], "=", 
      RowBox[{"N", "@", 
       FractionBox[
        SuperscriptBox["10", 
         RowBox[{"pKa", "-", "pH"}]], 
        RowBox[{
         SuperscriptBox["10", 
          RowBox[{"pKa", "-", "pH"}]], "+", "1"}]]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"pKa_", ",", "q_", ",", "pH_"}], "]"}], ":=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"q", "<", "0"}], ",", 
        RowBox[{"acid", "[", 
         RowBox[{
          RowBox[{"pKa", "+", "dpH"}], ",", "pH"}], "]"}], ",", 
        RowBox[{"base", "[", 
         RowBox[{
          RowBox[{"pKa", "+", "dpH"}], ",", "pH"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"charge", "[", "pH_", "]"}], ":=", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"aan", "[", 
           RowBox[{"[", "i", "]"}], "]"}], 
          RowBox[{"q", "[", 
           RowBox[{"[", "i", "]"}], "]"}], 
          RowBox[{"f", "[", 
           RowBox[{
            RowBox[{"aam", "[", 
             RowBox[{"d", ",", 
              RowBox[{"aach", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
            RowBox[{
             RowBox[{"aan", "[", 
              RowBox[{"[", "i", "]"}], "]"}], 
             RowBox[{"q", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], ",", "pH"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "q", "]"}]}], "}"}]}], "]"}], "+", 
       RowBox[{"base", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"aapka", "[", 
           RowBox[{"[", 
            RowBox[{"8", ",", "3"}], "]"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", "pH"}], "]"}], "+", 
       RowBox[{"acid", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"aapka", "[", 
           RowBox[{"[", 
            RowBox[{"9", ",", "3"}], "]"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", "pH"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"chden", "[", "pH_", "]"}], ":=", 
      RowBox[{
       RowBox[{"Abs", "@", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"aan", "[", 
            RowBox[{"[", "i", "]"}], "]"}], 
           RowBox[{"q", "[", 
            RowBox[{"[", "i", "]"}], "]"}], 
           RowBox[{"f", "[", 
            RowBox[{
             RowBox[{"aam", "[", 
              RowBox[{"d", ",", 
               RowBox[{"aach", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
             RowBox[{
              RowBox[{"aan", "[", 
               RowBox[{"[", "i", "]"}], "]"}], 
              RowBox[{"q", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], ",", "pH"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "q", "]"}]}], "}"}]}], "]"}]}], "+", 
       RowBox[{"Abs", "@", 
        RowBox[{"base", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"aapka", "[", 
            RowBox[{"[", 
             RowBox[{"8", ",", "3"}], "]"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "pH"}], "]"}]}], "+", 
       RowBox[{"Abs", "@", 
        RowBox[{"acid", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"aapka", "[", 
            RowBox[{"[", 
             RowBox[{"9", ",", "3"}], "]"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "pH"}], "]"}]}]}]}], ";", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"charge", "[", "pH", "]"}], ",", 
       RowBox[{"chden", "[", "pH", "]"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{
  3.847965008278447*^9, {3.847965105717668*^9, 3.847965177101815*^9}, {
   3.847965318239254*^9, 3.8479653530593348`*^9}, 3.8480489337535877`*^9, 
   3.8480502544517097`*^9, {3.8480528939308643`*^9, 3.848052894204206*^9}, {
   3.8480529508562393`*^9, 3.8480529511281643`*^9}, {3.907749627136619*^9, 
   3.907749675915234*^9}, {3.912514586459594*^9, 3.912514602502174*^9}, {
   3.912516015979995*^9, 3.912516049527698*^9}, {3.9125165306166363`*^9, 
   3.9125166701066437`*^9}, {3.912516719961234*^9, 3.912516791034597*^9}, {
   3.912516829419821*^9, 3.912516914087647*^9}, {3.912516959820338*^9, 
   3.912516960247294*^9}, {3.912517003639415*^9, 3.912517019106105*^9}, {
   3.9125171296519938`*^9, 3.912517147043893*^9}, {3.9125171828758593`*^9, 
   3.912517194463183*^9}, {3.912517907800384*^9, 3.912517925058352*^9}, {
   3.9535517915169287`*^9, 3.953551821151115*^9}, {3.953552185348734*^9, 
   3.9535522113170424`*^9}, {3.953552243389861*^9, 3.9535522484786663`*^9}, {
   3.953552280850565*^9, 3.9535522957721853`*^9}, {3.9535527807006483`*^9, 
   3.953552824060524*^9}, {3.9535533691469803`*^9, 3.9535534414259443`*^9}, {
   3.953700552474051*^9, 3.9537005641982937`*^9}, {3.953700910086253*^9, 
   3.953700931855439*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"d6e8e367-dbfa-4feb-8b8e-46186131dcd4"]
