Cell["\<\
Function that transform x and y values in 2D list, can use the functional form:
#^3 &. xySc[data, #^3 &, 1]\
\>", "Text",
 CellChangeTimes->{{3.961420665465096*^9, 3.9614206885954657`*^9}, {
  3.963925972309963*^9, 
  3.963926012585026*^9}},ExpressionUUID->"697bc5d6-9c1f-47ef-a62f-\
5a07c73a6456"],

Cell[BoxData[
 RowBox[{
  RowBox[{"xySc", "[", 
   RowBox[{"data2D_", ",", 
    RowBox[{"xSpec_", ":", "Identity"}], ",", 
    RowBox[{"ySpec_", ":", "Identity"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"xs", "=", 
       RowBox[{"data2D", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
      RowBox[{"ys", "=", 
       RowBox[{"data2D", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", "xF", ",", "yF"}], 
     "}"}], ",", 
    RowBox[{
     RowBox[{"xF", "=", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "xSpec", "]"}], "===", "Function"}], ",", 
        "xSpec", ",", 
        RowBox[{"NumericQ", "[", "xSpec", "]"}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"xSpec", " ", "#"}], ")"}], "&"}], ",", "True", ",", 
        "Identity"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"yF", "=", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "ySpec", "]"}], "===", "Function"}], ",", 
        "ySpec", ",", 
        RowBox[{"NumericQ", "[", "ySpec", "]"}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"ySpec", " ", "#"}], ")"}], "&"}], ",", "True", ",", 
        "Identity"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"xF", "/@", "xs"}], ",", 
        RowBox[{"yF", "/@", "ys"}]}], "}"}], "]"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[27]:=",ExpressionUUID->"f314c869-ad26-4495-ae21-7216f5f98bad"]
}, Open  ]],

