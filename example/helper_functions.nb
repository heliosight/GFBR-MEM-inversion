  3.95370028312033*^9}},ExpressionUUID->"18c4a56c-6176-4d16-a9a0-\
1ab98955e655"],

Cell["\<\
Functions for conversion of pH values from measured temperature (RT) with \
given temperature correction coefficient (dT) to desired temperature FT.\
\>", "Text",
 CellChangeTimes->{{3.8994534181799107`*^9, 3.899453491213073*^9}, {
  3.9537002889198103`*^9, 
  3.953700334988653*^9}},ExpressionUUID->"e6c2cbd1-1002-49f6-b205-\
36123c1efac2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fromRT", "[", 
    RowBox[{"ph_", ",", "RT_", ",", "dT_", ",", "FT_"}], "]"}], ":=", 
   RowBox[{"Round", "[", 
    RowBox[{
     RowBox[{"ph", "-", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"FT", "-", "RT"}], "]"}], "dT"}]}], ",", "0.01"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"toRT", "[", 
    RowBox[{"ph_", ",", "RT_", ",", "dT_", ",", "FT_"}], "]"}], ":=", 
   RowBox[{"Round", "[", 
    RowBox[{
     RowBox[{"ph", "+", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"FT", "-", "RT"}], "]"}], "dT"}]}], ",", "0.01"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.897381978242975*^9, 3.897381980730279*^9}, {
  3.897384226482307*^9, 3.897384226654873*^9}, {3.8975573366813297`*^9, 
  3.897557352383623*^9}, {3.8976189226764793`*^9, 3.897618973254706*^9}, {
  3.89866922450274*^9, 3.898669235561591*^9}},
 CellLabel->"In[36]:=",ExpressionUUID->"ac607686-85fd-4861-8b41-beff5438f48c"]
}, Open  ]],

