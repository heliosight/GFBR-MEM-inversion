Cell[BoxData[
 RowBox[{
  RowBox[{"labels2", "[", 
   RowBox[{
   "xaxes_", ",", "yaxes_", ",", "panellabel_", ",", "offset_", ",", 
    "fontsize_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"xa", "=", "xaxes"}], ",", 
      RowBox[{"ya", "=", "yaxes"}], ",", 
      RowBox[{"panlbl", "=", "panellabel"}], ",", 
      RowBox[{"off", "=", "offset"}], ",", 
      RowBox[{"fsz", "=", "fontsize"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", "out", "]"}], ";", 
     RowBox[{"out", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Text", "[", 
