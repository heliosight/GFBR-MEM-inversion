Cell[BoxData[
 RowBox[{
  RowBox[{"labels", "[", 
   RowBox[{
   "xaxes_", ",", "yaxes_", ",", "plotlabel_", ",", "panellabel_", ",", 
    "offset_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"xa", "=", "xaxes"}], ",", 
      RowBox[{"ya", "=", "yaxes"}], ",", 
      RowBox[{"plbl", "=", "plotlabel"}], ",", 
      RowBox[{"panlbl", "=", "panellabel"}], ",", 
      RowBox[{"off", "=", "offset"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", "out", "]"}], ";", 
     RowBox[{"out", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"xa", ",", "fs", ",", 
            RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}]}], "]"}], ",", 
          
          RowBox[{"Offset", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{"Scaled", "[", 
             RowBox[{"{", 
              RowBox[{"0.5", ",", 
               RowBox[{"-", 
                RowBox[{"off", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], "]"}]}], "]"}]}], 
         "]"}], ",", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"Rotate", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"ya", ",", "fs", ",", 
              RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}]}], "]"}], ",", 
            FractionBox["\[Pi]", "2"]}], "]"}], ",", 
          RowBox[{"Offset", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{"Scaled", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", 
                RowBox[{"off", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], ",", "0.5"}], "}"}], 
             "]"}]}], "]"}]}], "]"}], ",", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"plbl", ",", "fs", ",", 
            RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}]}], "]"}], ",", 
          
          RowBox[{"Offset", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{"Scaled", "[", 
             RowBox[{"{", 
              RowBox[{"0.5", ",", 
               RowBox[{"1.", "+", 
                RowBox[{"0.5", " ", 
                 RowBox[{"off", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}]}]}], "}"}], "]"}]}], 
           "]"}]}], "]"}], ",", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"panlbl", "\[Equal]", "\"\<\>\""}], ",", "\"\<\>\"", ",",
               "panlbl"}], "]"}], ",", 
            RowBox[{"2", "fs"}], ",", "Bold", ",", 
            RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}]}], "]"}], ",", 
          
          RowBox[{"Scaled", "[", 
           RowBox[{"{", 
            RowBox[{"0.1", ",", "0.9"}], "}"}], "]"}]}], "]"}]}], "}"}]}], ";", 
     RowBox[{"Clear", "[", 
      RowBox[{"xa", ",", "ya", ",", "plbl"}], "]"}], ";", "out"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.80311226106219*^9, 3.803112268072047*^9}, 
   3.81659357324214*^9, {3.831523456031898*^9, 3.831523461679359*^9}, {
