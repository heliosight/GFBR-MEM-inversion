Cell["JPK AFM height data .txt to .png images export function", "Text",
 CellChangeTimes->{{3.939370208421895*^9, 3.9393702845879498`*^9}, {
  3.939371548789693*^9, 3.939371551789885*^9}, {3.939791919801825*^9, 
  3.939791921439067*^9}},ExpressionUUID->"a168f919-5cbe-4d05-a72a-\
574d213aee68"],

Cell[BoxData[
 RowBox[{
  RowBox[{"imgjpkex", "[", 
   RowBox[{"filename_", ",", "range_", ",", "smoothing_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"fn", "=", "filename"}], ",", 
      RowBox[{"rng", "=", "range"}], ",", 
      RowBox[{"smth", "=", "smoothing"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"ClearAll", "[", 
      RowBox[{
      "a", ",", "as", ",", "mas", ",", "af", ",", "ai", ",", "pars", ",", 
       "res"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"res", "=", 
      RowBox[{
       RowBox[{"Take", "[", 
        RowBox[{
         RowBox[{"Import", "[", 
          RowBox[{"fn", ",", "\"\<Table\>\""}], "]"}], ",", "18"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"8", ",", "3"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{
       SuperscriptBox["10", "9"], 
       RowBox[{"Drop", "[", 
        RowBox[{
         RowBox[{"Import", "[", 
          RowBox[{"fn", ",", "\"\<Table\>\""}], "]"}], ",", "18"}], "]"}]}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"smooth", "[", 
         RowBox[{"#", ",", 
          RowBox[{"First", "@", "smth"}], ",", 
          RowBox[{"Last", "@", "smth"}]}], "]"}], "&"}], "/@", "a"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mas", "=", 
      RowBox[{"Median", "[", 
       RowBox[{"Flatten", "[", "as", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"af", "=", 
      RowBox[{"as", "-", "mas"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pars", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ColorFunction", "->", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"afmHot", "[", 
            RowBox[{"Rescale", "[", 
             RowBox[{"#1", ",", "rng"}], "]"}], "]"}], "&"}], ")"}]}], ",", 
        RowBox[{"ColorFunctionScaling", "->", "False"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ai", "=", 
      RowBox[{"ReliefImage", "[", 
       RowBox[{"af", ",", 
        RowBox[{"ColorFunction", "->", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"afmHot", "[", 
            RowBox[{"Rescale", "[", 
             RowBox[{"#1", ",", "rng"}], "]"}], "]"}], "&"}], ")"}]}], ",", 
        RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
        RowBox[{"Method", "->", "\"\<DiffuseReflection\>\""}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"StringTake", "[", 
         RowBox[{"fn", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"-", "4"}]}], "}"}]}], "]"}], "<>", "\"\<png\>\""}], ",", 
       "ai"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.939370258279805*^9, 3.939370266728732*^9}, {
