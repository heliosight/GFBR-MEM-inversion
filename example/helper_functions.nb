a390a6ce43a3"],

Cell[TextData[{
 "Absorbance at Amide I band corresponds to peptide bond, hence molecular \
weight of the protein and number of residues required. ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Epsilon]", "p"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f45a8679-a3e6-45e7-a651-9877adb0f324"],
 "=950 [L ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["mol", 
    RowBox[{"-", "1"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a4396e1d-149e-4718-b130-e90e08dc5d82"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["cm", 
    RowBox[{"-", "1"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3a4d09ea-9fb9-4580-ba11-b54ae71bea02"],
 "]."
}], "Text",
 CellChangeTimes->{{3.953794674087337*^9, 3.953794722954172*^9}, {
  3.9537947707515907`*^9, 
  3.9537948650024652`*^9}},ExpressionUUID->"7da66c0a-d543-46e8-8060-\
39bb94e87b4f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cuf", "[", 
    RowBox[{
    "absorbanceFtir_", ",", "extinction_", ",", "pathlength_", ",", 
     "molecularweight_", ",", "Nresidues_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"A", "=", "absorbanceFtir"}], ",", 
       RowBox[{"epd", "=", "extinction"}], ",", 
       RowBox[{"l", "=", "pathlength"}], ",", 
       RowBox[{"mw", "=", "molecularweight"}], ",", 
       RowBox[{"nr", "=", "Nresidues"}]}], "}"}], ",", 
     RowBox[{"UnitConvert", "[", 
      RowBox[{
       RowBox[{
        FractionBox["A", 
         RowBox[{"epd", " ", "l"}]], 
        FractionBox["1", 
         RowBox[{
          RowBox[{"2", " ", "nr"}], "-", "1"}]], "mw"}], ",", 
       RowBox[{"\"\<Milligrams\>\"", "/", "\"\<Milliliters\>\""}]}], "]"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[38]:=",ExpressionUUID->"6758c347-21fc-475d-b5c3-34f6777ea95c"]
}, Open  ]],

