bcb1932f429f"],

Cell["\<\
Position function finds a position of a value in a one dimensional list\
\>", "Text",
 CellChangeTimes->{{3.9150805272752523`*^9, 
  3.9150805790037537`*^9}},ExpressionUUID->"0686191a-2885-4dee-893b-\
38a34750db40"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lps", "[", 
   RowBox[{"list_", ",", "value_", ",", 
    RowBox[{"number_", ":", "1"}]}], "]"}], ":=", 
  RowBox[{"First", "@", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Position", "[", 
     RowBox[{"list", ",", 
      RowBox[{"First", "@", 
       RowBox[{"Nearest", "[", 
        RowBox[{"list", ",", 
         RowBox[{"N", "@", "value"}], ",", "number"}], "]"}]}]}], "]"}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9150803913750043`*^9, 3.9150804908470707`*^9}, {
