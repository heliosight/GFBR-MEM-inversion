  3.95355844462615*^9}},ExpressionUUID->"88d90cb9-7fdb-46af-82bd-\
0140c18563aa"],

Cell["\<\
Extracting total area from base output of freeSASA program, file name as \
input.\
\>", "Text",
 CellChangeTimes->{{3.953558446236196*^9, 
  3.953558472283766*^9}},ExpressionUUID->"e2fb3af4-c89c-40bb-bb30-\
a55eb2bbf65c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"freeSASAbasetot", "[", "file_String", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"text", ",", "match"}], "}"}], ",", 
    RowBox[{
     RowBox[{"text", "=", 
      RowBox[{"Import", "[", 
       RowBox[{"file", ",", "\"\<Text\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"match", "=", 
      RowBox[{"StringCases", "[", 
       RowBox[{"text", ",", 
        RowBox[{
         RowBox[{
         "RegularExpression", 
          "[", "\"\<Total\\\\s*:\\\\s*([0-9]+\\\\.?[0-9]*)\>\"", "]"}], ":>", 
         
         RowBox[{"ToExpression", "[", "\"\<$1\>\"", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"match", "=!=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"First", "[", "match", "]"}], ",", 
       RowBox[{"Missing", "[", "\"\<NoMatch\>\"", "]"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[35]:=",ExpressionUUID->"db176811-bc27-4cd3-a533-aeeb199bed78"]
}, Open  ]],

