  3.875953178737905*^9, 3.875953184360738*^9}, {3.8759532763882103`*^9, 
  3.875953496615895*^9}, {3.875953549716455*^9, 3.875953552020375*^9}, {
  3.953189199762437*^9, 3.9531892031331577`*^9}, {3.953276148758905*^9, 
  3.953276163234241*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"2ec66b67-b43b-443b-8654-6aea60ee7e2e"],

Cell["\<\
DLS  files data extract for preconfigured export in Malvern with \
size/intensity and autocorrelation/time data and multiple entries.\
\>", "Text",
 CellChangeTimes->{{3.9144840760192003`*^9, 
  3.9144841575135927`*^9}},ExpressionUUID->"1cfb86fd-b1d7-4e88-bf81-\
611ac7f6f4c3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dlsm", "[", "filename_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "datar", ",", "data", ",", "snam", ",", "size", ",", "int", ",", 
      "corrdel", ",", "corr"}], "}"}], ",", 
    RowBox[{
     RowBox[{"datar", "=", 
      RowBox[{"Import", "[", 
       RowBox[{"filename", ",", "\"\<TSV\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"data", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Length", "[", 
            RowBox[{"datar", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}], "&"}], "/@", 
        "datar"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"snam", "=", 
      RowBox[{"Drop", "[", 
       RowBox[{
        RowBox[{"data", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", "1"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"size", "=", 
      RowBox[{"Drop", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Cases", "[", 
          RowBox[{"data", ",", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x_", "/;", 
               RowBox[{"StringMatchQ", "[", 
                RowBox[{"x", ",", 
                 RowBox[{"\"\<Size\>\"", "~~", "___", "~~", "\"\<)\>\""}]}], 
                "]"}]}], "}"}], " ", ",", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"_", ",", 
               RowBox[{
                RowBox[{"Length", "[", 
                 RowBox[{"data", "\[Transpose]"}], "]"}], "-", "1"}]}], 
              "]"}]}], "]"}]}], "]"}], "\[Transpose]"}], ",", "1"}], "]"}]}], 
     ";", 
     RowBox[{"int", "=", 
      RowBox[{"Drop", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Cases", "[", 
          RowBox[{"data", ",", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x_", "/;", 
               RowBox[{"StringMatchQ", "[", 
                RowBox[{"x", ",", 
                 RowBox[{"\"\<Int\>\"", "~~", "___", "~~", "\"\<)\>\""}]}], 
                "]"}]}], "}"}], " ", ",", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"_", ",", 
               RowBox[{
                RowBox[{"Length", "[", 
                 RowBox[{"data", "\[Transpose]"}], "]"}], "-", "1"}]}], 
              "]"}]}], "]"}]}], "]"}], "\[Transpose]"}], ",", "1"}], "]"}]}], 
     ";", 
     RowBox[{"corrdel", "=", 
      RowBox[{"Drop", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Cases", "[", 
          RowBox[{"data", ",", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x_", "/;", 
               RowBox[{"StringMatchQ", "[", 
                RowBox[{"x", ",", 
                 
                 RowBox[{"\"\<Correlation Delay\>\"", "~~", "___", 
                  "~~", "\"\<)\>\""}]}], "]"}]}], "}"}], " ", ",", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"_", ",", 
               RowBox[{
                RowBox[{"Length", "[", 
                 RowBox[{"data", "\[Transpose]"}], "]"}], "-", "1"}]}], 
              "]"}]}], "]"}]}], "]"}], "\[Transpose]"}], ",", "1"}], "]"}]}], 
     ";", 
     RowBox[{"corr", "=", 
      RowBox[{"Drop", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Cases", "[", 
          RowBox[{"data", ",", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x_", "/;", 
               RowBox[{"StringMatchQ", "[", 
                RowBox[{"x", ",", 
                 
                 RowBox[{"\"\<Correlation Data\>\"", "~~", "___", 
                  "~~", "\"\<]\>\""}]}], "]"}]}], "}"}], " ", ",", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"_", ",", 
               RowBox[{
                RowBox[{"Length", "[", 
                 RowBox[{"data", "\[Transpose]"}], "]"}], "-", "1"}]}], 
              "]"}]}], "]"}]}], "]"}], "\[Transpose]"}], ",", "1"}], "]"}]}], 
     ";", 
     RowBox[{"{", 
      RowBox[{"snam", ",", "size", ",", "int", ",", "corrdel", ",", "corr"}], 
      "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.899280458611755*^9, 3.89928049094436*^9}, {
   3.899280588911701*^9, 3.899280637709298*^9}, {3.89928069560098*^9, 
   3.8992808077845182`*^9}, {3.899280942918673*^9, 3.899280960602901*^9}, {
   3.899281076869022*^9, 3.899281111733884*^9}, {3.899281156191117*^9, 
   3.899281161027905*^9}, 3.899367078019677*^9, {3.975146208043007*^9, 
   3.975146236315572*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"d2aacd81-789f-4a22-9619-d80501f05c48"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Mass photometry", "Subsubsection",
 CellChangeTimes->{{3.939371614971128*^9, 
  3.939371622184092*^9}},ExpressionUUID->"95080314-a6ad-4608-98e2-\
be0a28063412"],

Cell["Average molecular weight from mass photometry distribution.", "Text",
 CellChangeTimes->{{3.883108259481507*^9, 
  3.883108282323357*^9}},ExpressionUUID->"b459872e-435f-47e2-89aa-\
57dbfa163a59"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Mwa", "[", 
   RowBox[{"distribution_", ",", "molecularweight_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"dist", "=", "distribution"}], ",", 
      RowBox[{"Mw", "=", "molecularweight"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"freq", "=", 
      RowBox[{"BinCounts", "[", 
       RowBox[{
        RowBox[{"Round", "@", 
         FractionBox["dist", "Mw"]}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"Max", "@", 
           FractionBox["dist", "Mw"]}], ",", "1"}], "}"}]}], "]"}]}], ";", 
     RowBox[{"M", "=", 
      RowBox[{"N", "@", 
       FractionBox[
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"freq", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", 
           SuperscriptBox["i", "2"]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "freq", "]"}]}], "}"}]}], "]"}], 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"freq", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "i"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "freq", "]"}]}], "}"}]}], "]"}]]}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.883039859912654*^9, 3.8830398851692266`*^9}, {
  3.883039961957696*^9, 3.883040083776964*^9}, {3.883044706718354*^9, 
  3.883044706871139*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"03e946b7-b116-4e42-a9f5-7f331d93aadf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Fractal crossover size", "Subsubsection",
 CellChangeTimes->{{3.975235298037195*^9, 
  3.9752353125992613`*^9}},ExpressionUUID->"854a6446-ca46-4f24-89b1-\
2999840edb22"],

Cell["\<\
This function estimates where scattering crosses over from the Rayleigh \
regime to the fractal power - law regime for a given measurement geometry . \
It returns the aggregate size, aggregation number, and characteristic DLS \
time .\
\>", "Text",
 CellChangeTimes->{{3.975235625314734*^9, 
  3.975235628225589*^9}},ExpressionUUID->"f6842db2-3295-420e-84d4-\
69baca0e828c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CrossoverFractal", "[", 
   RowBox[{
    RowBox[{"R0NM_", "?", "NumericQ"}], ",", 
    RowBox[{"(*", 
     RowBox[{"monomer", " ", "radius", " ", "in", " ", "nm"}], "*)"}], 
    RowBox[{"Df_", "?", "NumericQ"}], ",", 
    RowBox[{"lambdaNM_", "?", "NumericQ"}], ",", 
    RowBox[{"(*", 
     RowBox[{"wavelength", " ", "nm"}], "*)"}], 
    RowBox[{"thetaDeg_", "?", "NumericQ"}], ",", 
    RowBox[{"(*", 
     RowBox[{"scattering", " ", "angle"}], "*)"}], 
    RowBox[{"n_", ":", "1.33"}]}], "           ", 
   RowBox[{"(*", 
    RowBox[{"refractive", " ", "index"}], "*)"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"kB", "=", 
       RowBox[{"1.380649", "*", 
        RowBox[{"10", "^", 
         RowBox[{"-", "23"}]}]}]}], ",", 
      RowBox[{"T", "=", "296"}], ",", 
      RowBox[{"eta", "=", "0.001"}], ",", "lambda", ",", "theta", ",", "q", ",",
       "RgNM", ",", "N", ",", "D", ",", "tau"}], "}"}], ",", 
    RowBox[{
     RowBox[{"lambda", "=", 
      RowBox[{"lambdaNM", "*", 
       RowBox[{"10", "^", 
        RowBox[{"-", "9"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"theta", "=", 
      RowBox[{"thetaDeg", "*", "Degree"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"q", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", " ", "Pi", " ", 
         RowBox[{"n", "/", "lambda"}]}], ")"}], "*", 
       RowBox[{"Sin", "[", 
        RowBox[{"theta", "/", "2"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", "crossover", "*)"}], 
     RowBox[{"RgNM", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "q"}], ")"}], "*", 
       RowBox[{"10", "^", "9"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"aggregation", " ", "number"}], "*)"}], 
     RowBox[{"N", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"RgNM", "/", "R0NM"}], ")"}], "^", "Df"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"DLS", " ", "time"}], "*)"}], 
     RowBox[{"D", "=", 
      RowBox[{"kB", " ", 
       RowBox[{"T", "/", 
        RowBox[{"(", 
         RowBox[{"6", " ", "Pi", " ", "eta", " ", "RgNM", "*", 
          RowBox[{"10", "^", 
           RowBox[{"-", "9"}]}]}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tau", "=", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"D", " ", 
         RowBox[{"q", "^", "2"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Rg_nm\>\"", "->", "RgNM"}], ",", 
       RowBox[{"\"\<N\>\"", "->", "N"}], ",", 
       RowBox[{"\"\<tau_s\>\"", "->", "tau"}]}], "|>"}]}]}], "]"}]}]], "Input",\

 CellChangeTimes->{{3.975235314981391*^9, 3.9752353149846907`*^9}, 
   3.9752354747288027`*^9},
 CellLabel->"In[21]:=",ExpressionUUID->"2fffbdec-0c47-42e3-ba87-d15cacd32a68"]
}, Open  ]],

