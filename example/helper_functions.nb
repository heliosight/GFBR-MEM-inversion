Cell[BoxData[
 RowBox[{
  RowBox[{"logTicks", "[", 
   RowBox[{"min_", ",", "max_"}], "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"10", "^", "i"}], ",", 
      RowBox[{"Superscript", "[", 
       RowBox[{"10", ",", "i"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"Ceiling", "[", 
       RowBox[{"Log10", "[", "min", "]"}], "]"}], ",", 
      RowBox[{"Floor", "[", 
       RowBox[{"Log10", "[", "max", "]"}], "]"}]}], "}"}]}], "]"}]}]], "Input",\

