Cell[BoxData[{
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"smpl", "=", "2"}], ";", 
     RowBox[{"ess", "[", 
      RowBox[{"0.05", ",", "0.2", ",", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1.5", ",", "2.5"}], "}"}], ",", "smpl"}], "]"}], ",", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2.0", ",", "3.0"}], "}"}], ",", "smpl"}], "]"}]}], "]"}]}],
     ",", "1000"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Select", "[", 
   RowBox[{"%", ",", 
    RowBox[{
     RowBox[{"#", "<=", "smpl"}], "&"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "[", "%", "]"}], "\[IndentingNewLine]", 
