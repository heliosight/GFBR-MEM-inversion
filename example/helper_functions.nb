Cell[BoxData[
 RowBox[{
  RowBox[{"imgjpk", "[", 
   RowBox[{"filename_", ",", "range_", ",", "smoothing_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"fn", "=", "filename"}], ",", 
      RowBox[{"rng", "=", "range"}], ",", 
      RowBox[{"smth", "=", "smoothing"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"ClearAll", "[", 
      RowBox[{
      "a", ",", "as", ",", "mas", ",", "af", ",", "ai", ",", "pars", ",", 
       "res"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"res", "=", 
      RowBox[{
       RowBox[{"Take", "[", 
        RowBox[{
         RowBox[{"Import", "[", 
          RowBox[{"fn", ",", "\"\<Table\>\""}], "]"}], ",", "18"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"8", ",", "3"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{
       SuperscriptBox["10", "9"], 
       RowBox[{"Drop", "[", 
        RowBox[{
         RowBox[{"Import", "[", 
          RowBox[{"fn", ",", "\"\<Table\>\""}], "]"}], ",", "18"}], "]"}]}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"smooth", "[", 
         RowBox[{"#", ",", 
          RowBox[{"First", "@", "smth"}], ",", 
          RowBox[{"Last", "@", "smth"}]}], "]"}], "&"}], "/@", "a"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mas", "=", 
      RowBox[{"Median", "[", 
       RowBox[{"Flatten", "[", "as", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"af", "=", 
      RowBox[{"as", "-", "mas"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pars", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ColorFunction", "->", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"afmHot", "[", 
            RowBox[{"Rescale", "[", 
             RowBox[{"#1", ",", "rng"}], "]"}], "]"}], "&"}], ")"}]}], ",", 
        RowBox[{"ColorFunctionScaling", "->", "False"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ai", "=", 
      RowBox[{"ReliefImage", "[", 
       RowBox[{"af", ",", 
        RowBox[{"ColorFunction", "->", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"afmHot", "[", 
            RowBox[{"Rescale", "[", 
             RowBox[{"#1", ",", "rng"}], "]"}], "]"}], "&"}], ")"}]}], ",", 
        RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
        RowBox[{"Method", "->", "\"\<DiffuseReflection\>\""}]}], "]"}]}]}]}], 
   "]"}]}]], "Input",
