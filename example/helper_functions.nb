Cell["Sample size estimate", "Text",
 CellChangeTimes->{{3.83152348092423*^9, 
  3.831523489148132*^9}},ExpressionUUID->"8f2ee8be-5a6c-4b15-815f-\
2a4879fb0794"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalPhi]", "[", "rv_", "]"}], "=", 
   RowBox[{"CDF", "[", 
    RowBox[{
     RowBox[{"NormalDistribution", "[", 
      RowBox[{"0", ",", "1"}], "]"}], ",", "rv"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"i\[CapitalPhi]", "[", "rv_", "]"}], "=", 
   RowBox[{"InverseCDF", "[", 
    RowBox[{
     RowBox[{"NormalDistribution", "[", 
      RowBox[{"0", ",", "1"}], "]"}], ",", "rv"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ess", "[", 
   RowBox[{"alpha_", ",", "beta_", ",", "sample1_", ",", "sample2_"}], "]"}], 
  ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"al", "=", "alpha"}], ",", 
      RowBox[{"bt", "=", "beta"}], ",", 
      RowBox[{"sm1", "=", "sample1"}], ",", 
      RowBox[{"sm2", "=", "sample2"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"\[Mu]1", "=", 
      RowBox[{"Mean", "[", "sm1", "]"}]}], ";", 
     RowBox[{"\[Mu]2", "=", 
      RowBox[{"Mean", "[", "sm2", "]"}]}], ";", 
     RowBox[{"\[Sigma]1", "=", 
      RowBox[{"StandardDeviation", "[", "sm1", "]"}]}], ";", 
     RowBox[{"\[Sigma]2", "=", 
      RowBox[{"StandardDeviation", "[", "sm2", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"n1", "=", 
      RowBox[{"Length", "[", "sm1", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"n2", "=", 
      RowBox[{"Length", "[", "sm2", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Sigma]p", "=", 
      SqrtBox[
       FractionBox[
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n1", "-", "1"}], ")"}], 
          SuperscriptBox["\[Sigma]1", "2"]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n2", "-", "1"}], ")"}], 
          SuperscriptBox["\[Sigma]2", "2"]}]}], 
        RowBox[{"(", 
         RowBox[{"n1", "+", "n2", "-", "2"}], ")"}]]]}], ";", 
     RowBox[{"ns", "=", 
      RowBox[{"Round", "@", 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{
           RowBox[{"i\[CapitalPhi]", "[", 
            RowBox[{"1", "-", 
             FractionBox["al", "2"]}], "]"}], "+", 
           RowBox[{"i\[CapitalPhi]", "[", 
            RowBox[{"1", "-", "bt"}], "]"}]}], 
          FractionBox[
           RowBox[{"Abs", "[", 
            RowBox[{"\[Mu]1", "-", "\[Mu]2"}], "]"}], "\[Sigma]p"]], ")"}], 
        "2"]}]}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.784541452142664*^9, 3.78454152119494*^9}, {
   3.784541804260727*^9, 3.784541805453952*^9}, {3.7845421662944*^9, 
   3.784542175046741*^9}, {3.784542734070526*^9, 3.784542734898419*^9}, {
   3.78454300077038*^9, 3.784543088684099*^9}, 3.784543344654389*^9, {
   3.784543399166033*^9, 3.7845434060337753`*^9}, 3.784543563227878*^9, {
   3.784543798261022*^9, 3.7845441119724092`*^9}, {3.784544175988465*^9, 
   3.7845441808256702`*^9}, {3.784544215273931*^9, 3.784544217691186*^9}, {
   3.915261282526764*^9, 3.915261415914042*^9}, {3.9152614774987173`*^9, 
   3.915261487016755*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"62f4397d-b2b4-445f-99fb-f5be5b046eb1"]
}, Open  ]],

