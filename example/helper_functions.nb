  3.867307863599699*^9}},ExpressionUUID->"374a3e7f-f8ea-49cb-8394-\
682fe5ae082b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"htf", "[", 
   RowBox[{"kinetictrace_", ",", 
    RowBox[{"midvalue_", ":", "0.5"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"lst", "=", "kinetictrace"}], ",", 
      RowBox[{"mv", "=", "midvalue"}], ",", "list"}], "}"}], ",", 
    RowBox[{
     RowBox[{"list", "=", 
      RowBox[{"Transpose", "@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"lst", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
         RowBox[{"Rescale", "@", 
          RowBox[{"lst", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"First", "@", 
      RowBox[{"Cases", "[", 
       RowBox[{"list", ",", 
        RowBox[{"{", 
         RowBox[{"_", ",", 
          RowBox[{"First", "@", 
           RowBox[{"Nearest", "[", 
            RowBox[{
             RowBox[{"list", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "mv"}], 
            "]"}]}]}], "}"}]}], "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{3.977396220937833*^9},
 CellLabel->"In[22]:=",ExpressionUUID->"dba656f6-9225-4c54-8f84-ca7ddf08bea5"],

