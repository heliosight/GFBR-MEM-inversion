Cell[BoxData[
 RowBox[{
  RowBox[{"dls", "[", "filename_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"fni", "=", "filename"}], "}"}], ",", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"data", ",", "size", ",", "int", ",", "vol", ",", "corr"}], 
      "]"}], ";", 
     RowBox[{"data", "=", 
      RowBox[{
       RowBox[{"Import", "[", 
        RowBox[{"fni", ",", "\"\<TSV\>\""}], "]"}], "\[Transpose]"}]}], ";", 
     RowBox[{"size", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Cases", "[", 
         RowBox[{"data", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"x_", "/;", 
             RowBox[{"StringMatchQ", "[", 
              RowBox[{"x", ",", 
               RowBox[{"\"\<S\>\"", "~~", "___", "~~", "\"\<)\>\""}]}], 
              "]"}]}], " ", ",", "_"}], "}"}]}], "]"}], "\[Transpose]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", 
     RowBox[{"int", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Cases", "[", 
         RowBox[{"data", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"x_", "/;", 
             RowBox[{"StringMatchQ", "[", 
              RowBox[{"x", ",", 
               RowBox[{"\"\<I\>\"", "~~", "___", "~~", "\"\<)\>\""}]}], 
              "]"}]}], " ", ",", "_"}], "}"}]}], "]"}], "\[Transpose]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", 
     RowBox[{"vol", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Cases", "[", 
         RowBox[{"data", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"x_", "/;", 
             RowBox[{"StringMatchQ", "[", 
              RowBox[{"x", ",", 
               RowBox[{"\"\<V\>\"", "~~", "___", "~~", "\"\<)\>\""}]}], 
              "]"}]}], " ", ",", "_"}], "}"}]}], "]"}], "\[Transpose]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", 
     RowBox[{"corr", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Cases", "[", 
         RowBox[{"data", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"x_", "/;", 
             RowBox[{"StringMatchQ", "[", 
              RowBox[{"x", ",", 
               RowBox[{"\"\<C\>\"", "~~", "___", "~~", "\"\<]\>\""}]}], 
              "]"}]}], " ", ",", "_"}], "}"}]}], "]"}], "\[Transpose]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"size", ",", "int"}], "}"}], "\[Transpose]"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"size", ",", "vol"}], "}"}], "\[Transpose]"}], ",", "corr", ",", 
       RowBox[{"Max", "[", "corr", "]"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.875948328428946*^9, 3.875948395253888*^9}, {
