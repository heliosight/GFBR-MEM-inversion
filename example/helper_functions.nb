3884d858c473"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"y", "=", 
   RowBox[{"N", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"2", 
        RowBox[{"Sin", "[", 
         RowBox[{"5", " ", 
          SuperscriptBox["10", 
           RowBox[{"-", "2"}]], "x"}], "]"}]}], "+", 
       RowBox[{"9", " ", 
        RowBox[{"PDF", "[", 
         RowBox[{
          RowBox[{"NormalDistribution", "[", 
           RowBox[{"11", ",", "3"}], "]"}], ",", "x"}], "]"}]}], "+", 
       RowBox[{"4", 
        RowBox[{"PDF", "[", 
         RowBox[{
          RowBox[{"NormalDistribution", "[", 
           RowBox[{"18", ",", "1"}], "]"}], ",", "x"}], "]"}]}], "+", 
       RowBox[{"2", 
        RowBox[{"PDF", "[", 
         RowBox[{
          RowBox[{"NormalDistribution", "[", 
           RowBox[{"24", ",", "0.5"}], "]"}], ",", "x"}], "]"}]}], "+", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.1"}], ",", "0.1"}], "}"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "30", ",", "0.2"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", 
   RowBox[{"bckgrnd", "[", 
    RowBox[{"y", ",", "0.009", ",", 
     RowBox[{"1.", " ", 
      SuperscriptBox["10", "5"]}], ",", "10"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", 
