Cell["\<\
The plot below compares the original g\:2082 data from the Malvern instrument \
(blue) with the processed g\:2081 data generated using clipG2toG1.\
\>", "Text",
 CellChangeTimes->{{3.9958673611544847`*^9, 3.995867428474764*^9}, 
   3.9958674989412327`*^9},ExpressionUUID->"90853605-5e9f-44da-a258-\
020943c8fc05"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dbsa", "=", 
   RowBox[{
    RowBox[{"N", "@", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SuperscriptBox["10", 
         RowBox[{"-", "6"}]], 
        RowBox[{
         RowBox[{"dlsm", "[", 
          RowBox[{"fnd", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"4", ",", "1"}], "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"dlsm", "[", 
         RowBox[{"fnd", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"5", ",", "1"}], "]"}], "]"}]}], "}"}]}], "\[Transpose]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g1bsac", "=", 
   RowBox[{"clipG2toG1", "[", 
    RowBox[{"dbsa", ",", 
     RowBox[{"16", " ", 
      SuperscriptBox["10", 
       RowBox[{"-", "2"}]]}], ",", 
     RowBox[{"1", " ", 
      SuperscriptBox["10", 
       RowBox[{"-", "4"}]]}], ",", "13"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Take", "[", 
      RowBox[{"dbsa", ",", "60"}], "]"}], ",", "g1bsac"}], "}"}], ",", 
   RowBox[{"ScalingFunctions", "->", 
    RowBox[{"{", "\"\<Log\>\"", "}"}]}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\!\(\*SubscriptBox[\(g\), \(2\)]\)\>\"", 
      ",", "\"\<\!\(\*SubscriptBox[\(g\), \(1\)]\)\>\""}], "}"}]}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<t, s\>\"", ",", 
      " ", "\"\<\!\(\*SubscriptBox[\(g\), \(1\)]\)\>\""}], "}"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.995864927575058*^9, 3.995864990022311*^9}, {
  3.995865382336652*^9, 3.995865384008491*^9}, {3.995866192087853*^9, 
